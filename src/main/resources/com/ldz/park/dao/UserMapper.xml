<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ldz.park.dao.UserMapper">
    <resultMap id="BaseResultMap" type="com.ldz.park.model.User">
        <result column="id" jdbcType="INTEGER" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="account" jdbcType="VARCHAR" property="account"/>
        <result column="openid" jdbcType="VARCHAR" property="openid"/>
        <result column="unionid" jdbcType="VARCHAR" property="unionid"/>
        <result column="doorplate" jdbcType="VARCHAR" property="doorplate"/>
        <result column="is_admin" jdbcType="TINYINT" property="isAdmin"/>
        <result column="channel" jdbcType="VARCHAR" property="channel"/>
        <result column="role" jdbcType="VARCHAR" property="role"/>
        <result column="mobile" jdbcType="VARCHAR" property="mobile"/>
        <result column="avatar" jdbcType="VARCHAR" property="avatar"/>
        <result column="description" jdbcType="VARCHAR" property="description"/>
        <result column="gmt_create" jdbcType="TIMESTAMP" property="gmtCreate"/>
        <result column="gmt_modify" jdbcType="TIMESTAMP" property="gmtModify"/>
        <result column="gmt_active" jdbcType="TIMESTAMP" property="gmtActive"/>

    </resultMap>

    <select id="getListAll" resultMap="BaseResultMap">
        select * from user
    </select>

    <select id="getUserList" resultMap="BaseResultMap">
        select id, name,account, doorplate,mobile ,is_admin,gmt_active from user
        <if test="keyword != null">
            <bind name="pattern" value="'%' + keyword + '%'"/>
            where (account like #{pattern} or name like#{pattern} )
        </if>
    </select>



    <select id="getUserByAccount" resultMap="BaseResultMap">
        select * from user where account = #{0}
    </select>

    <select id="getUserByOpenid" resultMap="BaseResultMap">
        select * from user where openid = #{openid} limit 1
    </select>

    <select id="getUserByMobile" resultMap="BaseResultMap">
        select * from user where mobile = #{mobile} limit 1
    </select>

    <select id="detail" resultMap="BaseResultMap">
        select * from user where id = #{id}
    </select>

    <insert id="add" useGeneratedKeys="true" keyProperty="user.id" keyColumn="id">
        insert into user (name, doorplate, account, openid, unionid, password, is_admin, channel, role, mobile, avatar, description, gmt_create, gmt_modify)
        values (#{user.name}, #{user.doorplate}, #{user.account}, #{user.openid}, #{user.unionid}, #{user.password}, #{user.isAdmin},
                <choose>
                    <when test="user.channel != null and user.channel != ''">#{user.channel}</when>
                    <otherwise>'admin'</otherwise>
                </choose>,
                <choose>
                    <when test="user.role != null and user.role != ''">#{user.role}</when>
                    <otherwise>'user'</otherwise>
                </choose>,
                #{user.mobile}, #{user.avatar}, #{user.description}, now(), now())
    </insert>

    <update id="update">
        update user
        <set>
            <if test="user.name != null">name = #{user.name},</if>
            <if test="user.doorplate != null">doorplate = #{user.doorplate},</if>
            <if test="user.account != null">account = #{user.account},</if>
            <if test="user.openid != null">openid = #{user.openid},</if>
            <if test="user.unionid != null">unionid = #{user.unionid},</if>
            <if test="user.password != null and user.password != ''">password = #{user.password},</if>
            <if test="user.isAdmin != null">is_admin = #{user.isAdmin},</if>
            <if test="user.channel != null and user.channel != ''">channel = #{user.channel},</if>
            <if test="user.role != null and user.role != ''">role = #{user.role},</if>
            <if test="user.mobile != null">mobile = #{user.mobile},</if>
            <if test="user.avatar != null">avatar = #{user.avatar},</if>
            <if test="user.description != null">description = #{user.description},</if>
            gmt_modify = now()
        </set>
        where id = #{user.id}
    </update>

    <delete id="delete">
        delete from user where id = #{id}
    </delete>

    <update id="resetPassword">
        update user set password = #{password}, gmt_modify = now() where id = #{id}
    </update>

    <insert id="insertToken">
        insert into user_login (user_id, token) values (#{userId}, #{token})
    </insert>
    <update id="clearToken">
        update user_login set token=uuid() where user_id=#{0}
    </update>

    <select id="getUserIdByToken" resultType="java.lang.Integer">
        select user_id from user_login where token = #{0}
    </select>
</mapper>
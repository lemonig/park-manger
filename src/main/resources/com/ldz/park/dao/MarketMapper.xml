<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ldz.park.dao.MarketMapper">

    <!-- 基础结果映射（优化：列名与属性驼峰映射一致，photo 用 ListHandler 保留） -->
    <resultMap id="BaseResultMap" type="com.ldz.park.model.Market">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="code" jdbcType="VARCHAR" property="code"/>
        <result column="owner_id" jdbcType="INTEGER" property="ownerId"/>
        <result column="price" jdbcType="NUMERIC" property="price"/>
        <result column="parking_no" jdbcType="VARCHAR" property="parkingNo"/>
        <result column="photo" jdbcType="VARCHAR" property="photo" typeHandler="com.ldz.park.util.ListHandler"/>
        <result column="description" jdbcType="VARCHAR" property="description"/>
        <result column="type" jdbcType="INTEGER" property="type"/>
        <result column="position_desc" jdbcType="VARCHAR" property="positionDesc"/>
        <result column="specs" jdbcType="VARCHAR" property="specs"/>
        <result column="phone" jdbcType="VARCHAR" property="phone"/>
        <result column="status" jdbcType="TINYINT" property="status"/>
        <result column="gmt_create" jdbcType="TIMESTAMP" property="gmtCreate"/>
        <result column="gmt_modify" jdbcType="TIMESTAMP" property="gmtModify"/>
        <!-- 预留字段 -->
        <result column="city" jdbcType="VARCHAR" property="city"/>
        <result column="area" jdbcType="VARCHAR" property="area"/>
        <result column="community" jdbcType="VARCHAR" property="community"/>
    </resultMap>

    <!-- 动态条件列表查询（支持分页 + 条件） -->
    <select id="list" resultMap="BaseResultMap" parameterType="com.ldz.park.model.Market">
        SELECT * FROM market
        <where>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="parkingNo != null and parkingNo != ''">
                AND number LIKE CONCAT('%', #{parkingNo}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <!-- 可扩展更多条件，如价格区间、时间等 -->
        </where>
        ORDER BY gmt_create DESC
    </select>

    <!-- 新增 -->
    <insert id="add" parameterType="com.ldz.park.model.Market" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO market
        (code, owner_id, price, number, description, type, position_desc, specs, phone, status, gmt_create, gmt_modify)
        VALUES
        (#{code}, #{ownerId}, #{price}, #{parkingNo}, #{description}, #{type}, #{positionDesc}, #{specs}, #{phone}, #{status}, NOW(), NOW())
    </insert>

    <!-- 更新 -->
    <update id="update" parameterType="com.ldz.park.model.Market">
        UPDATE market
        <set>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="price != null">price = #{price},</if>
            <if test="parkingNo != null">number = #{parkingNo},</if>
            <if test="description != null">description = #{description},</if>
            <if test="type != null">type = #{type},</if>
            <if test="positionDesc != null">position_desc = #{positionDesc},</if>
            <if test="specs != null">specs = #{specs},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="status != null">status = #{status},</if>
            gmt_modify = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除 -->
    <delete id="delete" parameterType="java.lang.Integer">
        DELETE FROM market WHERE id = #{id}
    </delete>

    <!-- 详情查询 -->
    <select id="getDetailById" resultMap="BaseResultMap" parameterType="java.lang.Integer">
        SELECT * FROM market WHERE id = #{id}
    </select>


    <!-- 批量插入图片 -->
    <insert id="insertImagesBatch">
        INSERT INTO market_images (market_code, image_id, create_by, create_time)
        VALUES
        <foreach collection="imageIds" item="imageId" separator=",">
            (#{marketCode}, #{imageId}, #{userId}, NOW())
        </foreach>
    </insert>

    <!-- 单图插入（兼容原方法） -->
    <insert id="insertImg">
        INSERT INTO market_images (market_code, image_id, create_by, create_time)
        VALUES (#{market_code}, #{image_id}, #{create_by}, NOW())
    </insert>

    <!-- 删除车位时清理图片关联 -->
    <delete id="deleteImagesByMarketCode">
        DELETE FROM market_images WHERE market_code = #{marketCode}
    </delete>

    <!-- 批量查询 -->
    <select id="selectImagesByMarketCodes" resultType="com.ldz.park.model.vo.market.SimpleImage">
        SELECT mi.market_code AS marketCode, mi.image_id AS id, f.url
        FROM market_images mi
        LEFT JOIN images f ON mi.image_id = f.id
        WHERE mi.market_code IN
        <foreach collection="codes" item="code" open="(" separator="," close=")">
            #{code}
        </foreach>
        ORDER BY mi.create_time ASC
    </select>

    <!-- 单码查询（兼容） -->
    <select id="selectImagesByMarketCode" resultType="com.ldz.park.model.vo.market.SimpleImage">
        SELECT mi.market_code AS marketCode, mi.image_id AS id, f.url
        FROM market_images mi
        LEFT JOIN images f ON mi.image_id = f.id
        WHERE mi.market_code = #{marketCode}
        ORDER BY mi.create_time ASC
    </select>

</mapper>
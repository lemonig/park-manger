<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ldz.park.dao.MarketMapper">
    <resultMap id="BaseResultMap" type="com.ldz.park.model.Market">
        <result column="id" jdbcType="INTEGER" property="id"/>
        <result column="owner_id" jdbcType="INTEGER" property="ownerId"/>
        <result column="price" jdbcType="NUMERIC" property="price"/>
        <result column="number" jdbcType="INTEGER" property="number"/>
        <result column="photo" property="photo" jdbcType="VARCHAR" typeHandler="com.ldz.park.util.ListHandler"/>
        <result column="description" jdbcType="VARCHAR" property="description"/>
        <result column="type" jdbcType="INTEGER" property="type"/>

    </resultMap>

    <select id="list" resultMap="BaseResultMap">
        select * from market
    </select>

    <insert id="add">
        insert into market(code,owner_id,price,number,description,type,gmt_create,gmt_modify)
            value(#{market.code},#{market.ownerId},#{market.price},#{market.number},#{market.description},#{market.type},now(),now())
    </insert>


    <update id="update">
        update market set
                          owner_id= #{market.ownerId},
                            price= #{market.price},
                          number = #{market.number},
                          type = #{market.type},
                           description = #{market.description},
                           gmt_modify = now()
        where id = #{market.id}
    </update>

    <delete id="delete">
        delete from market where id = #{param1}
    </delete>
</mapper>